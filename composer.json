{
    "name": "nebrix/panel",
    "type": "project",
    "description": "Nebrix hosting management platform (modernized fork of the RED-Host Panel)",
    "license": "MIT",
    "authors": [
        {
            "name": "Björn Schleyer",
            "homepage": "https://www.bschleyer.de",
            "role": "Original RED-Host Panel author"
        }
    ],
    "require": {
        "php": "~8.3.0 || ~8.4.0",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-sodium": "*",
        "bacon/bacon-qr-code": "^3.0",
        "dompdf/dompdf": "^3.1",
        "guzzlehttp/guzzle": "^7.9",
        "monolog/monolog": "^3.7",
        "phpmailer/phpmailer": "^7.0",
        "robthree/twofactorauth": "^3.0",
        "stripe/stripe-php": "^23.0",
        "twig/twig": "^3.14",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Nebrix\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nebrix\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "find src tests database config public bin -name '*.php' -print0 | xargs -0 -n1 php -l > /dev/null",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "check": [
            "@composer validate --strict",
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
