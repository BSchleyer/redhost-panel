{% extends 'layouts/customer.twig' %}
{% block title %}{{ 'Access data'|t }}{% endblock %}
{% block content %}
<div class="page-header"><div><h1>{{ 'Access data'|t }} – {{ service.name }}</h1><p class="muted"><a href="/services/{{ service.id }}">&larr; {{ 'Back'|t }}</a></p></div></div>
<div class="card"><div class="card-body">
    <div class="alert alert-warning">{{ 'Keep this information private. We recommend changing initial passwords after the first login.'|t }}</div>
    <dl class="details">
    {% for key, value in credentials %}
        <dt>{{ key|humanize|t }}</dt>
        <dd class="kv-secret">
            {% if key matches '/pass|key|token/' %}
                <code id="cred-{{ loop.index }}" class="hidden">{{ value }}</code>
                <button type="button" class="btn btn-sm btn-outline" data-reveal="#cred-{{ loop.index }}">{{ 'Show'|t }}</button>
                <button type="button" class="btn btn-sm btn-outline" data-copy="#cred-{{ loop.index }}">{{ 'Copy'|t }}</button>
            {% elseif value starts with 'https://' %}
                <a href="{{ value }}" target="_blank" rel="noopener noreferrer">{{ value }}</a>
            {% else %}
                <code>{{ value }}</code>
            {% endif %}
        </dd>
    {% endfor %}
    </dl>
</div></div>
{% endblock %}
