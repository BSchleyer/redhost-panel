{% extends 'layouts/customer.twig' %}
{% import 'macros/forms.twig' as f %}
{% block title %}{{ 'Profile'|t }}{% endblock %}
{% block content %}
<div class="page-header"><div><h1>{{ 'Profile'|t }}</h1><p class="muted">{{ 'Your contact and billing details. They are printed on invoices.'|t }}</p></div></div>
<form method="post" action="/account/profile" novalidate>
    {{ csrf_field() }}
    <div class="card">
        <div class="card-body">
            <div class="form-grid">
                {{ f.input('first_name', 'First name', profile.first_name, 'text', {required: true}) }}
                {{ f.input('last_name', 'Last name', profile.last_name, 'text', {required: true}) }}
                {{ f.input('company', 'Company', profile.company) }}
                {{ f.input('vat_id', 'VAT ID', profile.vat_id) }}
                {{ f.input('address_line1', 'Address', profile.address_line1) }}
                {{ f.input('address_line2', 'Address line 2', profile.address_line2) }}
                {{ f.input('postcode', 'Postcode', profile.postcode) }}
                {{ f.input('city', 'City', profile.city) }}
                {{ f.input('country', 'Country (ISO code, e.g. DE)', profile.country, 'text', {maxlength: 2}) }}
                {% if profile.vat_id %}<div class="form-row"><label>{{ 'VAT ID status'|t }}</label><div>{% if profile.vat_id_valid is same as(1) or profile.vat_id_valid == '1' %}<span class="badge badge-success">{{ 'verified'|t }}</span>{% if profile.vat_id_name %} <span class="small muted">{{ profile.vat_id_name }}</span>{% endif %}{% elseif profile.vat_id_valid is not null %}<span class="badge badge-danger">{{ 'not valid'|t }}</span>{% else %}<span class="badge badge-neutral">{{ 'not checked yet'|t }}</span>{% endif %}</div></div>{% endif %}
                {{ f.input('phone', 'Phone', profile.phone, 'tel') }}
                {{ f.select('language', 'Language', languages, profile.language|default('en')) }}
                {{ f.checkbox('auto_pay_credit', 'Pay renewals automatically from my credit balance', profile.auto_pay_credit is defined ? profile.auto_pay_credit == 1 : true, {help: 'Renewal invoices are settled from your account credit as soon as it covers them.'}) }}
                <div class="form-row"><label>{{ 'E-mail address'|t }}</label><input type="email" value="{{ profile.email }}" disabled><div class="help">{{ 'Contact support to change your e-mail address.'|t }}</div></div>
            </div>
        </div>
        <div class="card-footer"><button class="btn btn-primary" type="submit">{{ 'Save profile'|t }}</button></div>
    </div>
</form>
{% endblock %}
