{% extends 'layouts/auth.twig' %}
{% import 'macros/forms.twig' as f %}
{% block title %}{{ 'Choose a new password'|t }}{% endblock %}
{% block content %}
<h1>{{ 'Choose a new password'|t }}</h1>
<form method="post" action="/password/reset" novalidate>
    {{ csrf_field() }}
    <input type="hidden" name="token" value="{{ token }}">
    {{ f.input('password', 'New password', '', 'password', {required: true, autocomplete: 'new-password', help: 'At least 10 characters.'}) }}
    {{ f.input('password_confirmation', 'Repeat new password', '', 'password', {required: true, autocomplete: 'new-password'}) }}
    <button class="btn btn-primary btn-block" type="submit">{{ 'Change password'|t }}</button>
</form>
{% endblock %}
