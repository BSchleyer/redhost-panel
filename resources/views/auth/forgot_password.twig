{% extends 'layouts/auth.twig' %}
{% import 'macros/forms.twig' as f %}
{% block title %}{{ 'Reset password'|t }}{% endblock %}
{% block content %}
<h1>{{ 'Reset password'|t }}</h1>
<p class="muted">{{ 'Enter your e-mail address and we will send you a link to choose a new password.'|t }}</p>
<form method="post" action="/password/forgot" novalidate>
    {{ csrf_field() }}
    {{ f.input('email', 'E-mail address', '', 'email', {required: true, autocomplete: 'email', autofocus: true}) }}
    {% include 'partials/captcha.twig' with {captcha: captcha} only %}
    <button class="btn btn-primary btn-block" type="submit">{{ 'Send reset link'|t }}</button>
</form>
<div class="auth-links"><a href="/login">{{ 'Back to sign in'|t }}</a></div>
{% endblock %}
