{% extends 'layouts/admin.twig' %}
{% import 'macros/forms.twig' as f %}
{% block title %}{{ 'Login history'|t }}{% endblock %}
{% block content %}
<div class="page-header"><div><h1>{{ 'Login history'|t }}</h1></div></div>
<div class="card">
    <div class="card-body">
        <form method="get" class="filters">
            <div class="form-row"><label for="s">{{ 'E-mail or IP'|t }}</label><input id="s" type="search" name="search" value="{{ filters.search }}"></div>
            {{ f.select('success', 'Result', {'': 'All', '1': 'Successful', '0': 'Failed'}, filters.success, {'data-autosubmit': true}) }}
            {{ f.select('staff', 'Accounts', {'': 'All', '1': 'Staff only'}, filters.staff_only ? '1' : '', {'data-autosubmit': true}) }}
            <button class="btn btn-outline" type="submit">{{ 'Filter'|t }}</button>
        </form>
    </div>
    <div class="table-wrap"><table class="table">
        <thead><tr><th>{{ 'Time'|t }}</th><th>{{ 'Account'|t }}</th><th>{{ 'Result'|t }}</th><th>IP</th><th>{{ 'Device'|t }}</th></tr></thead>
        <tbody>
        {% for l in result.items %}
            <tr><td class="nowrap">{{ l.created_at|dt }}</td><td>{{ l.user_email|default(l.identifier) }}{% if l.role_name %} <span class="badge badge-neutral">{{ l.role_name }}</span>{% endif %}</td>
                <td>{% if l.success %}<span class="badge badge-success">{{ 'success'|t }}</span>{% else %}<span class="badge badge-danger">{{ l.reason|humanize|t }}</span>{% endif %}</td>
                <td class="mono small">{{ l.ip }}</td><td class="small">{{ l.user_agent }}</td></tr>
        {% else %}<tr><td colspan="5" class="empty">{{ 'No entries.'|t }}</td></tr>{% endfor %}
        </tbody>
    </table></div>
    {% include 'partials/pagination.twig' with {total: result.total, per_page: 50} %}
</div>
{% endblock %}
