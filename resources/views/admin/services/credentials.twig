{% extends 'layouts/admin.twig' %}
{% block title %}{{ 'Access data'|t }}{% endblock %}
{% block content %}
<div class="page-header"><div><h1>{{ 'Access data'|t }} – {{ service.name }}</h1><p class="muted"><a href="/admin/services/{{ service.id }}">&larr; {{ 'Back'|t }}</a></p></div></div>
<div class="alert alert-warning">{{ 'Viewing customer access data is recorded in the audit log.'|t }}</div>
<div class="card"><div class="card-body"><dl class="details">
    {% for key, value in credentials %}<dt>{{ key|humanize }}</dt><dd class="kv-secret"><code id="c{{ loop.index }}" class="{{ key matches '/pass|key|token/' ? 'hidden' : '' }}">{{ value }}</code>{% if key matches '/pass|key|token/' %} <button type="button" class="btn btn-sm btn-outline" data-reveal="#c{{ loop.index }}">{{ 'Show'|t }}</button>{% endif %}</dd>{% else %}<dd class="muted">{{ 'No access data stored.'|t }}</dd>{% endfor %}
</dl></div></div>
{% endblock %}
