{% extends 'layouts/admin.twig' %}
{% block title %}{{ pool.name }}{% endblock %}
{% block content %}
<div class="page-header"><div><h1>{{ pool.name }}</h1><p class="muted"><span class="mono">{{ pool.network }}</span> · {{ 'Gateway'|t }} <span class="mono">{{ pool.gateway }}</span>{% if pool.dns %} · DNS <span class="mono">{{ pool.dns }}</span>{% endif %} · <a href="/admin/ip-pools">&larr; {{ 'IP pools'|t }}</a></p></div>
    {% if can('integrations.manage') %}<form method="post" action="/admin/ip-pools/{{ pool.id }}/delete" data-confirm="{{ 'Delete this pool?'|t }}">{{ csrf_field() }}<button class="btn btn-danger" type="submit">{{ 'Delete pool'|t }}</button></form>{% endif %}
</div>
<div class="card"><div class="table-wrap"><table class="table">
    <thead><tr><th>{{ 'Address'|t }}</th><th>{{ 'Status'|t }}</th><th>{{ 'Service'|t }}</th><th>{{ 'Note'|t }}</th><th></th></tr></thead>
    <tbody>{% for a in addresses %}
        <tr><td class="mono">{{ a.address }}</td>
            <td><span class="badge {{ a.status == 'free' ? 'badge-success' : (a.status == 'assigned' ? 'badge-info' : 'badge-warning') }}">{{ a.status|t }}</span></td>
            <td>{% if a.service_id %}<a href="/admin/services/{{ a.service_id }}">#{{ a.service_id }} {{ a.service_name }}</a>{% endif %}</td>
            <td class="small">{{ a.note }}</td>
            <td class="actions">{% if can('integrations.manage') and a.status != 'assigned' %}
                <form method="post" action="/admin/ip-pools/{{ pool.id }}/addresses/{{ a.id }}" class="filters filters-inline">{{ csrf_field() }}
                    <input type="hidden" name="status" value="{{ a.status == 'free' ? 'reserved' : 'free' }}">
                    {% if a.status == 'free' %}<input type="text" name="note" class="input-inline" placeholder="{{ 'Reason'|t }}" aria-label="{{ 'Reason'|t }}" maxlength="255">{% endif %}
                    <button class="btn btn-sm btn-outline" type="submit">{{ a.status == 'free' ? 'Reserve'|t : 'Release'|t }}</button></form>
            {% endif %}</td></tr>
    {% endfor %}</tbody>
</table></div></div>
{% endblock %}
