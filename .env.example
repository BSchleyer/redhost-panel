# -----------------------------------------------------------------------------
# Nebrix Panel – environment configuration
#
# Copy to .env and fill in. NEVER commit .env. Only infrastructure settings live
# here; company data, branding, SMTP, payment providers and integrations are
# configured in the admin panel and stored (secrets encrypted) in the database.
# -----------------------------------------------------------------------------

APP_NAME=Nebrix
# production | staging | local
APP_ENV=production
# Debug output is only shown when APP_ENV=local AND APP_DEBUG=true.
APP_DEBUG=false
APP_URL=https://panel.example.com
# Generate with: php bin/nebrix key:generate   (encrypts stored credentials – back it up!)
APP_KEY=
# Comma-separated old keys that can still decrypt data after a key rotation.
APP_PREVIOUS_KEYS=
APP_HSTS=true
# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-* headers are trusted.
TRUSTED_PROXIES=

# Host port used by docker-compose
APP_PORT=8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nebrix
DB_USERNAME=nebrix
DB_PASSWORD=
DB_SOCKET=

SESSION_IDLE_MINUTES=60
SESSION_LIFETIME_HOURS=12
# Defaults to true when APP_URL starts with https://
SESSION_SECURE_COOKIE=true

LOG_PATH=storage/logs/nebrix.log
# debug | info | notice | warning | error
LOG_LEVEL=info
LOG_RETENTION_DAYS=30

# Server console (noVNC): public WebSocket URL of the console proxy
# (bin/nebrix console:proxy). Default: APP_URL with ws(s):// + /console/ws.
CONSOLE_WS_URL=
# Host port of the console proxy in docker-compose (bound to 127.0.0.1).
CONSOLE_PORT=8081
# Limits of the console proxy (0 = unlimited). Per-IP limits use X-Forwarded-For
# only from TRUSTED_PROXIES.
#CONSOLE_MAX_PER_IP=10
#CONSOLE_MAX_PER_USER=3

# Integration network policy (SSRF protection). Keep both false in production
# unless an integration really runs on the same host or without TLS.
INTEGRATIONS_ALLOW_HTTP=false
INTEGRATIONS_ALLOW_LOOPBACK=false
INTEGRATIONS_TIMEOUT=20
